<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
 "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.andy.spring.ex.mybatis.repository.ReviewRepository">

	<select id="selectReview" parameterType="int"
		resultType="com.andy.spring.ex.mybatis.domain.Review">
		<!-- 이 SQL 쿼리에 외부에서 들어오는 파라미터가 어떤 타입인지 MyBatis에 알려주는 것 -->
		SELECT
		`id`,
		`storeId`,
		`menu`,
		`userName`,
		`point`,
		`review`,
		`createdAt`,
		`updatedAt`
		FROM
		`new_review`
		
		WHERE
		`id` = #{id}
		<!-- 여기서는 #{id}에 들어가는 값의 타입이 int임을 명시,
		즉, XML 쿼리 안에 #{id}가 있는데, 이 자리에 들어갈 파라미터가 정수형임을 알게 함 -->
		
		<!-- 쿼리에 값 넣을 때 타입이 무엇인지 알아야 제대로 바인딩 가능
		쿼리 결과를 어떤 타입으로 변환할지도 MyBatis가 알아야 하기 때문 -->
		
	</select>
	
<!-- 
@Param("id") 어노테이션이 메서드 파라미터 id를 XML 쿼리 내 #{id} 변수와 매핑해줍니다.
parameterType="int"는 전달되는 파라미터 타입이 int임을 명시.
resultType="com.andy.spring.ex.mybatis.domain.Review"는 쿼리 결과를 Review 클래스 객체로 매핑해서 반환한다는 의미입니다.
즉, 인터페이스 메서드와 XML 쿼리가 연결돼서 MyBatis가 자동으로 쿼리 실행, 결과 매핑, 반환까지 처리해주는 구조입니다.
 -->
 
	<insert id="insertReview" parameterType="map">
		Insert INTO
		`new_review`
		(
		`storeId`
		,`menu`
		,`userName`
		,`point`
		,`review`
		)
		VALUE
		(
		#{storeId}
		,#{menu}
		,#{userName}
		,#{point}
		,#{review}
		)
	</insert>

	<insert id="insertReviewByObject"
		parameterType="com.andy.spring.ex.mybatis.domain.Review">

		Insert INTO
		`new_review`
		(
		`storeId`
		,`menu`
		,`userName`
		,`point`
		,`review`
		)
		VALUE
		(
		#{storeId}
		,#{menu}
		,#{userName}
		,#{point}
		,#{review}
		)
	</insert>

</mapper>